# Loca release environment.
#
# Copy this to `.env` (gitignored) and fill in. The release scripts read from
# `.env`; missing keypairs are generated and written back on first run.

# --- Cloudflare auth -------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID also forms the R2 S3 endpoint host
# (`<account>.r2.cloudflarestorage.com`), so it is required for R2 uploads.
# CLOUDFLARE_API_TOKEN authenticates the landing-page Worker deploy via wrangler
# (part of `deno task release`); leave it empty to fall back to a stored
# `wrangler login` OAuth session (interactive, persists in ~/.config/.wrangler/).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- R2 object credentials (S3 API) ----------------------------------------
# R2 object upload/copy/delete goes over the S3-compatible endpoint, not wrangler,
# so this is a separate credential from CLOUDFLARE_API_TOKEN above.
# Create an "Object Read & Write" R2 API token: dashboard -> Storage & databases
# -> R2 -> Overview, then "Manage" in the Account Details > API Tokens card (the
# card is only on Overview, not on a bucket page). Scope it to the release bucket,
# which must exist first. It yields an Access Key ID + Secret Access Key, and the
# secret is shown only once. Required for `deno task release`.
LOCA_R2_ACCESS_KEY_ID=
LOCA_R2_SECRET_ACCESS_KEY=

# --- Manifest signing (auto-generated) -------------------------------------
# Ed25519 keypair, base64-standard-encoded raw bytes (32 bytes each).
# The release:core / release:client scripts generate these on first run if
# both are empty, and write the public half into
# packages/loca-core/data/signing-keys.json so every compiled core binary
# trusts the matching signatures.
#
# - PRIVATE key never leaves this file. Treat it like any other secret;
#   losing it means you must rotate the public key in signing-keys.json AND
#   re-sign every published manifest.
# - PUBLIC key is committed via signing-keys.json. Safe to share.
LOCA_SIGNING_PRIVATE_KEY_B64=
LOCA_SIGNING_PUBLIC_KEY_B64=

# --- Tauri client updater keypair ------------------------------------------
# tauri-plugin-updater uses its own minisign-style keypair (not the Ed25519
# pair above). Generate with `cargo tauri signer generate` and paste the
# outputs below. The private key is the multi-line text block; the
# password is what you typed when generating it (empty for no password).
#
# release:client substitutes the public half into
# packages/loca-client/src/tauri/tauri.conf.json before the client build,
# then signs the produced bundles with the private half (via the
# TAURI_SIGNING_PRIVATE_KEY env var the build pipeline reads).
TAURI_UPDATER_PUBLIC_KEY=
TAURI_UPDATER_PRIVATE_KEY=
TAURI_UPDATER_PRIVATE_KEY_PASSWORD=

# --- Android release keystore ----------------------------------------------
# Signs the release APK (release:android). Android verifies the APK signature on
# install/update, so this is the real trust gate for self-hosted mobile updates;
# the Ed25519 key above also signs android.json. Generate once with keytool:
#   keytool -genkey -v -keystore loca-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
# then base64 the .jks into LOCA_ANDROID_KEYSTORE_B64 (e.g. `base64 -i
# loca-release.jks`). Leave blank to skip the android item in a release run.
LOCA_ANDROID_KEYSTORE_B64=
LOCA_ANDROID_KEYSTORE_PASSWORD=
LOCA_ANDROID_KEY_ALIAS=upload
LOCA_ANDROID_KEY_PASSWORD=

# --- Apple signing (macOS + iOS, optional) ---------------------------------
# Covers the macOS client bundle (Developer ID signing + notarization), the
# macOS .pkg installer (Installer signing + notarization), and the iOS build
# (App Store Connect signing + upload). ALL OPTIONAL and purely secret-driven:
# leave everything blank and the macOS build keeps ad-hoc signing
# (tauri.conf.json's signingIdentity "-"), the .pkg ships unsigned, and the iOS
# build/release is skipped (an unsigned Simulator build is still possible
# locally). Fill them
# and the same runs sign + notarize + ship iOS with no other switch; see the
# step-by-step at scripts/release/macos-signing.md. Apple can't be cross-signed,
# so these are read only on a macOS host/runner. The App Store Connect API-key
# trio (APPLE_API_*) is what notarization, iOS cloud signing, and the .ipa
# upload use.
#
# Signing identity: the certificate's common name, e.g.
#   "Developer ID Application: Your Name (TEAMID1234)". Locally you can leave
# APPLE_CERTIFICATE/APPLE_CERTIFICATE_PASSWORD blank and rely on the cert already
# in your login keychain; on CI, export the cert as a base64 .p12 into
# APPLE_CERTIFICATE (+ its password) so the runner can import it.
APPLE_SIGNING_IDENTITY=
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
#
# Installer identity for the macOS .pkg installer: productsign requires a
# "Developer ID Installer" certificate, a DIFFERENT cert kind from the
# Application identity above (which productsign rejects), e.g.
#   "Developer ID Installer: Your Name (TEAMID1234)". Locally only the identity
# is needed (login keychain); on CI also export the Installer cert as a base64
# .p12 into APPLE_INSTALLER_CERTIFICATE (+ password) - the runner imports it
# into an ephemeral keychain for the signing run. Unset => the .pkg ships
# unsigned.
APPLE_INSTALLER_SIGNING_IDENTITY=
APPLE_INSTALLER_CERTIFICATE=
APPLE_INSTALLER_CERTIFICATE_PASSWORD=
#
# Notarization credentials - fill EITHER the Apple ID trio OR the App Store
# Connect API-key trio (not both). APPLE_PASSWORD is an app-specific password
# (appleid.apple.com), not your Apple ID login password.
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
# ...or the App Store Connect API key. Locally point APPLE_API_KEY_PATH at the
# .p8 file and leave APPLE_API_KEY_B64 empty; on CI it is the reverse (a runner
# cannot carry a file path as a secret, so the base64 .p8 goes in
# APPLE_API_KEY_B64 and ci-build materializes the key file itself). The iOS
# release requires this trio: it drives Xcode's automatic cloud signing and the
# .ipa upload, so the key needs the Admin role on App Store Connect.
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=
APPLE_API_KEY_B64=

# --- Windows Authenticode (optional, DORMANT) ------------------------------
# Empty by default (no cert yet): the client + Core NSIS installers ship
# unsigned and the install flow strips Mark-of-the-Web. Fill the thumbprint of
# a cert in the runner's store (or a full sign command with %1 for the file, e.g.
# an Azure Trusted Signing dlib invocation) to Authenticode-sign the installers.
WINDOWS_CERTIFICATE_THUMBPRINT=
WINDOWS_SIGN_COMMAND=
WINDOWS_TIMESTAMP_URL=

# --- Domains ---------------------------------------------------------------
# Override only if you're forking and pointing at different hostnames.
# These must match `WEBSITE_BASE_URL` / `STORAGE_BASE_URL` in
# packages/loca-core/src/config.ts.
LOCA_WEBSITE_DOMAIN=loca.rzkyif.com
LOCA_STORAGE_DOMAIN=get.loca.rzkyif.com

# --- R2 bucket -------------------------------------------------------------
# Set up once per Cloudflare account; see packages/loca-website/README.md.
LOCA_R2_BUCKET=loca-releases

# --- GitHub release automation (optional) ----------------------------------
# Used by scripts/release/core.ts when resolving upstream sidecar binaries
# (llama-server, whisper-server, deno) to raise the GitHub API rate limit.
# A fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=
