.DS_Store
node_modules
target
dist
.svelte-kit

# Build / generated (under packages/loca-client/)
packages/loca-client/build
packages/loca-client/.svelte-kit
packages/loca-client/.vite
packages/loca-client/package
packages/loca-client/static/vad

# Build / generated (under packages/loca-website/)
packages/loca-website/dist
packages/loca-website/.astro
packages/loca-website/.wrangler
packages/loca-website/public/release-state.json

# Deno
.deno-cache

# Tauri-generated schemas
packages/loca-client/src/tauri/gen/schemas

# Env
.env
.env.*
!.env.example

# Signing material (defense-in-depth; real secrets live in gitignored .env)
*.jks
*.keystore
keystore.properties
*.p12
*.pfx
*.p8
*.pem
*.key

# Vite temp files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tooling local state
.claude/
.todo
# Full per-package gate output written by scripts/pkg.ts on every run
.gate-logs/

# Reference only
reference/

# Agent coordination artefacts for the Rust port: plans, per-package status,
# the ADR log. Working notes for whoever is driving the port, not a deliverable,
# and they are referenced by comment throughout `packages/loca-core-rs/src/**`
# (those references resolve for anyone with the folder and dangle for anyone
# without it).
#
# Anchored: unanchored, this would also swallow any future `docs/` folder nested
# in a package (a website content collection, say) with no error and no diff.
/docs/

# Release staging tree, `scripts/release/ci-build.ts --stage-dir` default.
/stage/

# The tiny GGUF the inference linkage test loads. Not committed; the test skips
# with an acquisition command when it is absent, so a fresh clone stays green.
packages/loca-core-rs/models/

# Vendored third-party sources, fetched by scripts/vendor-llama.ts at the SHA
# pinned in packages/loca-core-rs/build.rs. Not committed, so a release built
# from a working tree is only as reproducible as that pin.
vendor/

# Test suite
# Scratch tests created by agents during dev. See AGENTS.md "Testing".
**/*.tmp.test.ts
**/*.tmp.test.rs