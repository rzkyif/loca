{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "ignorePatterns": ["**/.svelte-kit", "**/.astro", "**/.wrangler"],
  "jsPlugins": ["./scripts/lint-plugins/oxlint-plugin.ts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "loca/no-em-dash": "error",
    "loca/no-builtin-palette-color": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["packages/loca-core-engine/src/**/*.ts"],
      "rules": {
        "loca/no-host-import": "error"
      }
    },
    {
      "files": ["packages/loca-core-engine/**/*.test.ts"],
      "rules": {
        "loca/no-host-import": "off"
      }
    },
    {
      "files": ["packages/loca-client/src/ui/**/*.{ts,tsx}"],
      "rules": {
        "loca/no-tauri-import": "error"
      }
    },
    {
      "files": ["packages/loca-client/src/ui/lib/platform/*.ts"],
      "rules": {
        "loca/no-tauri-import": "off"
      }
    }
  ]
}
