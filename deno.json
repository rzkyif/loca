{
  "workspace": [
    "./packages/loca-shared",
    "./packages/loca-core-rs",
    "./packages/loca-core-ffi",
    "./packages/loca-client",
    "./packages/loca-website",
    "./packages/loca-extension-builtin",
    "./packages/loca-extension-samples",
    "./packages/loca-model-catalog",
    "./packages/loca-core-updater"
  ],
  "nodeModulesDir": "auto",
  "unstable": ["raw-imports"],
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225",
    "@std/tar": "jsr:@std/tar@^0.1.0",
    "@noble/ed25519": "jsr:@noble/ed25519@^3.0.0",
    "zod": "npm:zod@^4.4.3",
    "aws4fetch": "npm:aws4fetch@^1.0.20"
  },
  "tasks": {
    "dev": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts",
    "dev:android": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts --android",
    "dev:ios": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts --ios",
    "dev:reset": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts --reset",
    "dev:reset:install": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts --reset --fresh-install",
    "dev:core": "deno task --cwd packages/loca-core-rs dev",
    "dev:client": "deno task --cwd packages/loca-client dev",
    "dev:client:android": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts --android --client-only",
    "dev:client:ios": "deno run -A --unsafely-ignore-certificate-errors=127.0.0.1 scripts/dev.ts --ios --client-only",
    "dev:website": "deno task --cwd packages/loca-website dev",

    "check": "deno run -A scripts/pkg.ts check && deno run -A scripts/check.ts && deno task contract:check",
    "lint:js": "deno run -A npm:oxlint@1.88.0 -c .oxlintrc.json . && deno run -A scripts/lint-walkers.ts",
    "lint": "deno task lint:js && deno run -A scripts/pkg.ts lint",
    "fmt": "deno run -A npm:oxfmt@0.73.0 . && deno run -A scripts/fmt-web.ts && deno run -A scripts/pkg.ts fmt",
    "fmt:check": "deno run -A npm:oxfmt@0.73.0 --check . && deno run -A scripts/fmt-web.ts --check && deno run -A scripts/pkg.ts fmt:check",
    "test": "deno run -A scripts/pkg.ts test",
    "test:js": "deno run -A scripts/pkg.ts test:js",
    "test:e2e": "deno run -A scripts/test-e2e.ts",
    "test:e2e:headless": "deno run -A scripts/test-e2e-headless.ts",

    "contract": "deno run -A scripts/contract/generate.ts",
    "contract:check": "deno run -A scripts/contract/generate.ts --check",

    "check:shared": "deno task --cwd packages/loca-shared check",
    "check:client": "deno task --cwd packages/loca-client check",
    "check:extension": "deno task --cwd packages/loca-extension-builtin check",
    "check:extension-samples": "deno task --cwd packages/loca-extension-samples check",
    "check:catalog": "deno task --cwd packages/loca-model-catalog check",

    "test:shared": "deno task --cwd packages/loca-shared test",
    "test:client": "deno task --cwd packages/loca-client test",
    "test:extension": "deno task --cwd packages/loca-extension-builtin test",
    "test:extension-samples": "deno task --cwd packages/loca-extension-samples test",
    "test:core-updater": "deno task --cwd packages/loca-core-updater test",
    "test:core-rs": "deno task --cwd packages/loca-core-rs test",

    "fmt:client": "deno task --cwd packages/loca-client fmt",
    "fmt:core-updater": "deno task --cwd packages/loca-core-updater fmt",
    "fmt:core-rs": "deno task --cwd packages/loca-core-rs fmt",

    "lint:client": "deno task --cwd packages/loca-client lint",
    "lint:core-updater": "deno task --cwd packages/loca-core-updater lint",
    "lint:core-rs": "deno task --cwd packages/loca-core-rs lint",

    "build:core-updater": "deno task --cwd packages/loca-core-updater build",
    "build:core-rs": "deno task --cwd packages/loca-core-rs build",

    "build": "deno run -A scripts/build.ts --channel=latest",
    "build:stable": "deno run -A scripts/build.ts --channel=stable",
    "build:core": "deno run -A scripts/build-core.ts --channel=latest",
    "build:core:stable": "deno run -A scripts/build-core.ts --channel=stable",
    "build:client": "deno run -A scripts/build-client.ts --channel=latest",
    "build:client:stable": "deno run -A scripts/build-client.ts --channel=stable",
    "build:client:android": "deno run -A scripts/build-android.ts --channel=latest",
    "build:client:android:stable": "deno run -A scripts/build-android.ts --channel=stable",
    "build:client:ios": "deno run -A scripts/build-ios.ts --channel=latest",
    "build:client:ios:stable": "deno run -A scripts/build-ios.ts --channel=stable",
    "build:catalog": "deno run -A scripts/catalog/build.ts",
    "build:website": "deno run -A scripts/website/build.ts",
    "release:ci-build": "deno run -A scripts/release/ci-build.ts",
    "release:ci-publish": "deno run -A scripts/release/ci-publish.ts",
    "release:ci-preflight": "deno run -A scripts/release/ci-preflight.ts",
    "release:ci-bump": "deno run -A scripts/release/ci-bump.ts",
    "remote-release": "deno run -A scripts/release/remote.ts --channel=latest",
    "remote-release:stable": "deno run -A scripts/release/remote.ts --channel=stable",
    "clean": "deno run -A scripts/clean.ts",
    "clean:stale": "deno run -A scripts/clean.ts --stale"
  },
  "exclude": [
    "**/node_modules",
    "**/target",
    "**/build",
    "**/dist",
    "**/.svelte-kit",
    "**/.astro",
    "**/.wrangler",
    "**/.deno-cache",
    "tests/e2e"
  ],
  "allowScripts": [
    "npm:esbuild@0.21.5",
    "npm:esbuild@0.27.3",
    "npm:esbuild@0.27.7",
    "npm:fsevents@2.3.3",
    "npm:protobufjs@7.5.8",
    "npm:workerd@1.20260518.1"
  ]
}
