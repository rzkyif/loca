---
// The no-JavaScript baseline of the install generator. Native <input type=radio>
// + CSS drive the OS selection and reveal the matching pre-rendered download
// buttons + how-to, so a reader with JS off (or broken) still gets working
// download links. InstallGenerator.svelte mounts the enhanced version over this
// (live OS/arch auto-detect + recommendation highlight); the host page shows
// exactly one via the data-js gate.
//
// Channel is locked to `latest` here: stable has not shipped, so the baseline
// only renders the latest-channel downloads. The enhanced island shows the
// (disabled) stable option for when it does.
import {
  androidApkUrl,
  appInstallers,
  finishStep,
  formatTag,
  installerHowto,
  linuxCoreInstallers,
  linuxCoreSteps,
  type NativeInstaller,
  OS_CHOICES,
} from "../lib/install.ts";

const CH = "latest";
const DESKTOP = ["macos", "linux", "windows"] as const;
type DesktopOs = (typeof DESKTOP)[number];

// The main download per desktop OS (unified installer / Linux AppImage),
// pre-rendered so the baseline can CSS-toggle the matching buttons. Android has
// none (it is the APK block).
const installers: Record<DesktopOs, NativeInstaller[]> = {
  macos: appInstallers("macos", CH),
  linux: appInstallers("linux", CH),
  windows: appInstallers("windows", CH),
};
const coreInstallers = linuxCoreInstallers(CH);
const coreSteps = linuxCoreSteps(CH);

const apk = androidApkUrl(CH);

// How-to steps, pre-rendered per desktop OS and CSS-toggled by the selected
// radio, the same way the download buttons are.
const installerSteps: Record<DesktopOs, ReturnType<typeof installerHowto>> = {
  macos: installerHowto("macos"),
  linux: installerHowto("linux"),
  windows: installerHowto("windows"),
};
const finishSteps: Record<DesktopOs, string> = {
  macos: finishStep("macos"),
  linux: finishStep("linux"),
  windows: finishStep("windows"),
};

const osId = (os: string) => `ig-os-${os}`;
const osName = "ig-os";

const label = "text-xs font-medium uppercase tracking-wide text-default-500";
const btnBase =
  "flex items-center justify-center gap-2 px-3 py-2 rounded-medium text-sm transition-colors";
const osBtn = `ig-os-btn ${btnBase} bg-surface-inset text-default-700 hover:bg-surface-inset-strong cursor-pointer`;
const btnActive = `${btnBase} bg-default-inverted-300 text-default-inverted-900`;
// Download buttons reuse the OS-picker's idle look, minus the selected state.
const dlBtn = `${btnBase} bg-surface-inset text-default-700 hover:bg-surface-inset-strong cursor-pointer`;
---

{
  /* not-prose: the baseline can render inside the manual's `.prose`, whose
  presetTypography would otherwise restyle the note paragraphs. No-op on
  /install, which has no prose ancestor. */
}
<div class="ig not-prose flex flex-col gap-6">
  {/* Operating system. */}
  <fieldset class="flex flex-col gap-2 border-0 p-0 m-0">
    <legend class={`${label} p-0`}>Operating System</legend>
    <div class="grid gap-2 grid-cols-2 sm:grid-cols-4">
      {
        OS_CHOICES.map((o, i) => (
          <>
            <input
              id={osId(o.id)}
              name={osName}
              class="ig-radio sr-only"
              type="radio"
              data-os={o.id}
              checked={i === 0}
            />
            <label for={osId(o.id)} class={osBtn}>
              <i class={`${o.icon} text-lg`} />
              {o.label}
            </label>
          </>
        ))
      }
    </div>
  </fieldset>

  {/* Channel, locked to latest for now (stable not yet released). */}
  <div class="flex flex-col gap-2">
    <span class={label}>Channel</span>
    <div class="grid grid-cols-2 gap-2">
      <span class={`${btnBase} bg-surface-inset text-default-500 opacity-60 cursor-not-allowed`}>
        <i class="i-material-symbols-shield-outline-rounded text-lg"></i>
        Stable
      </span>
      <span class={btnActive}>
        <i class="i-material-symbols-bolt-rounded text-lg"></i>
        Latest
      </span>
    </div>
  </div>

  {/* The main download: one installer per arch, CSS-toggled by the OS radios. */}
  <div class="ig-dlsec flex flex-col gap-2">
    <span class={`${label} ig-dltitle ig-dltitle-macos`}>Download the installer</span>
    <span class={`${label} ig-dltitle ig-dltitle-windows`}>Download the installer</span>
    <span class={`${label} ig-dltitle ig-dltitle-linux`}>Download the app (AppImage)</span>
    {
      /* No "recommended" highlight here: it keys off the detected OS/arch, which
    needs the island. The no-JS baseline shows every button neutral. */
    }
    {
      DESKTOP.map((os) => (
        <div class={`ig-dl ig-dl-${os} grid grid-cols-2 gap-2`}>
          {installers[os].map((inst) => (
            <a href={inst.url} class={dlBtn}>
              <i class="i-material-symbols-download-rounded text-lg" />
              {inst.archLabel}
            </a>
          ))}
        </div>
      ))
    }
  </div>

  {/* The Linux-only standalone Core packages. */}
  <div class="ig-linuxcore flex-col gap-2">
    <span class={label}>Run the Core on this machine too</span>
    <div class="grid grid-cols-2 gap-2">
      {
        coreInstallers.map((inst) => (
          <a href={inst.url} class={dlBtn}>
            <i class="i-material-symbols-download-rounded text-lg" />
            Loca Core · {formatTag(inst.format)}
          </a>
        ))
      }
    </div>
    <ol class="m-0 flex flex-col gap-1 text-sm text-default-600 list-decimal pl-5">
      {coreSteps.map((step) => <li>{step}</li>)}
    </ol>
  </div>

  {
    /* Android installs from a downloaded APK, not an installer. Its own labeled
    block, shown only when Android is the selected OS. */
  }
  <div class="ig-android flex-col gap-2">
    <span class={label}>Download</span>
    <div class="flex flex-col gap-3 rounded-large bg-surface-inset px-4 py-3">
      <p class="text-sm text-default-700 m-0">
        The Android app is a signed APK you install directly.
      </p>
      <a
        href={apk}
        class="inline-flex items-center justify-center gap-2 rounded-large bg-default-inverted-300 px-4 py-2.5 text-sm text-default-inverted-900 hover:cursor-pointer"
      >
        <i class="i-material-symbols-download-rounded text-lg"></i>
        Download the Android APK
      </a>
      <ol class="m-0 flex flex-col gap-1 text-sm text-default-600 list-decimal pl-5">
        <li>Open the downloaded file on your phone.</li>
        <li>If asked, allow installing apps from this source.</li>
        <li>Confirm the install, then open Loca and connect it to a Core.</li>
      </ol>
    </div>
  </div>

  {/* How to Install, pre-rendered per desktop OS and CSS-toggled like the rest. */}
  <div class="ig-howto flex flex-col gap-2">
    <span class={label}>How to Install</span>
    {
      DESKTOP.map((os) => (
        <ol
          class={`ig-steps ig-steps-${os} m-0 flex-col gap-2 text-sm text-default-700 list-decimal pl-5`}
        >
          {installerSteps[os].map((step) =>
            typeof step === "string" ? (
              <li>{step}</li>
            ) : (
              <li>
                {step.text}
                {step.sub.length > 0 && (
                  <ul class="mt-1 flex flex-col gap-1 list-disc pl-5">
                    {step.sub.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                )}
              </li>
            ),
          )}
          <li>{finishSteps[os]}</li>
          <li>
            Setting up a server or a machine without a screen? See{" "}
            <a href="/manual/getting-started/installing" class="underline hov:text-default-700">
              headless installs
            </a>{" "}
            in the manual.
          </li>
          <li>
            If you ever need to uninstall, follow{" "}
            <a href="/manual/maintenance/uninstalling" class="underline hov:text-default-700">
              the uninstallation guide
            </a>
            .
          </li>
        </ol>
      ))
    }
  </div>
</div>

<style>
  /* Selected OS button: the inverted fill of the segmented controls' knob,
     driven by the native radio that immediately precedes each label. */
  .ig-radio:checked + .ig-os-btn {
    background: var(--default-d-300);
    color: var(--default-d-900);
  }
  :global(html.dark) .ig-radio:checked + .ig-os-btn {
    background: var(--default-300);
    color: var(--default-900);
  }

  /* Keyboard focus lands on the visually-hidden radio; resurface the ring on
     its visible label. */
  .ig-radio:focus-visible + .ig-os-btn {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* OS -> which downloads / titles / steps show. Keyed off the checked radio's
     data-os, scoped to the .ig root. */
  .ig-dl,
  .ig-dltitle,
  .ig-steps,
  .ig-linuxcore,
  .ig-android {
    display: none;
  }
  .ig:has(.ig-radio[data-os="macos"]:checked) .ig-dl-macos,
  .ig:has(.ig-radio[data-os="linux"]:checked) .ig-dl-linux,
  .ig:has(.ig-radio[data-os="windows"]:checked) .ig-dl-windows {
    display: grid;
  }
  .ig:has(.ig-radio[data-os="macos"]:checked) .ig-dltitle-macos,
  .ig:has(.ig-radio[data-os="linux"]:checked) .ig-dltitle-linux,
  .ig:has(.ig-radio[data-os="windows"]:checked) .ig-dltitle-windows {
    display: block;
  }
  .ig:has(.ig-radio[data-os="macos"]:checked) .ig-steps-macos,
  .ig:has(.ig-radio[data-os="linux"]:checked) .ig-steps-linux,
  .ig:has(.ig-radio[data-os="windows"]:checked) .ig-steps-windows {
    display: flex;
  }
  /* The unified-installer note applies to macOS/Windows only. */
  .ig:has(.ig-radio[data-os="linux"]:checked) .ig-dlnote {
    display: none;
  }
  /* The standalone Core packages are a Linux-only section. */
  .ig:has(.ig-radio[data-os="linux"]:checked) .ig-linuxcore {
    display: flex;
  }
  /* Android has its own block and hides the desktop sections. */
  .ig:has(.ig-radio[data-os="android"]:checked) .ig-android {
    display: flex;
  }
  .ig:has(.ig-radio[data-os="android"]:checked) .ig-dlsec,
  .ig:has(.ig-radio[data-os="android"]:checked) .ig-howto {
    display: none;
  }
</style>
