---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Install" description="Loca is currently not available for installation.">
  <main class="mx-auto w-full max-w-2xl px-4 pt-6 pb-10 flex flex-col gap-6">
    <h1 class="text-2xl font-semibold text-default-900">Install Loca</h1>

    <p class="text-default-500">
      Loca is currently not available for installation. If you're interested in the idea, check out
      <a href="https://github.com/rzkyif/loca" class="underline hov:text-default-700">
        the source code on GitHub
      </a>.
    </p>
  </main>
</BaseLayout>
